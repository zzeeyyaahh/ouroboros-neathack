# Crustdata: dashboard API key. Bearer token, sent as `authorization: Bearer <key>`.
CRUSTDATA_API_KEY=

# OpenAI key for the worker/supervisor LLM calls.
OPENAI_API_KEY=

# neatlogs: Settings -> API keys -> the TOP key (Project API key). NOT the nlw_ HTTP ingest key.
NEATLOGS_API_KEY=

# Optional overrides
# OURO_MODEL=gpt-4o
# OURO_WORKFLOW=ouroboros-worker
# OURO_FAULT_INJECT=0
